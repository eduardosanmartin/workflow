# Formato compatible con bash (scripts/respaldo.sh lo lee con `. ./.env`), con python-dotenv
# y con el env_file de Docker Compose:
#   - Los comentarios van en su propia línea, nunca al final de un valor.
#   - Los valores con espacios o con el carácter $ van entre comillas simples: CLAVE='valor con espacios'

# ── Aplicación ──
# Clave larga y aleatoria: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=change-me
FLASK_PORT=5001
# Pendiente: el dominio público con https:// (se usa en el QR y en los enlaces de los correos)
APP_BASE_URL=http://localhost:5001
# Pendiente: el mismo dominio, sin https:// (lo usa Caddy)
DOMINIO=
# 1 en producción (detrás de Caddy); docker-compose.prod.yml ya lo fija
PROXIES_CONFIABLES=0

# ── Base de datos ──
DATABASE_NAME=workflow
DATABASE_USER=workflow
# Use solo letras y números
DATABASE_PASSWORD=change-me
DATABASE_HOST=localhost
DATABASE_PORT=5432
# Base para pytest (se borra y se recrea en cada corrida). Debe existir y pertenecer a DATABASE_USER.
TEST_DATABASE_NAME=workflow_test
# Vacío en desarrollo sin Redis (límites en memoria); docker-compose.prod.yml lo fija
REDIS_URL=

# ── SMTP (correos al postulante) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=matricula-noreply@unach.cl
SMTP_FROM_NAME='Matrícula UNACH'
SMTP_USE_TLS=true
# Pendiente: correo o teléfono de contacto que se muestra en los correos (entre comillas si tiene espacios)
CONTACTO_MATRICULA=
# Los correos automáticos no hacen esperar al usuario
CORREO_EN_SEGUNDO_PLANO=true

# ── CAPTCHA del formulario QR (Cloudflare Turnstile) ──
# Pendiente: se obtienen en dash.cloudflare.com al registrar el dominio.
# Vacías: CAPTCHA desactivado (solo desarrollo). Claves de prueba de Cloudflare que siempre aprueban:
#   sitio 1x00000000000000000000AA · secreta 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Super administrador inicial ──
SUPERADMIN_EMAIL=
SUPERADMIN_NAME=Administrador
# Recomendado: hash bcrypt entre comillas simples (contiene $). Alternativa: SUPERADMIN_PASSWORD en texto plano.
SUPERADMIN_PASSWORD_HASH=
