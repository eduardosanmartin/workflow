<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definiciones_Ciclo" targetNamespace="http://unach.cl/workflow-matricula" exporter="Sistema WorkFlow Matrícula" exporterVersion="1.0">
  <bpmn:collaboration id="Colaboracion_Ciclo">
    <bpmn:participant id="Pool_Ciclo" name="Administración del proceso" processRef="Proceso_Ciclo" />
  </bpmn:collaboration>
  <bpmn:process id="Proceso_Ciclo" name="Ciclo de vida del proceso de matrícula" isExecutable="false">
    <bpmn:documentation>RF-01 a RF-08, RF-18, RF-24 y RF-26: configuración, operación, cierre y eliminación de datos.</bpmn:documentation>
    <bpmn:laneSet id="Carriles_Ciclo">
      <bpmn:lane id="L_Admin" name="Administrador">
        <bpmn:flowNodeRef>Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Crear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Crear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Usuarios</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Activar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Valido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Cerrar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Ges" name="Gestor / Administrador">
        <bpmn:flowNodeRef>T_Carga</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Reportes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Exportar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Staff" name="Staff y postulantes">
        <bpmn:flowNodeRef>CA_Recorridos</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Sis" name="Sistema">
        <bpmn:flowNodeRef>T_Pendientes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Fecha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Purgar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio" name="Nuevo período de matrícula">
      <bpmn:outgoing>F_Inicio_M_Crear</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="M_Crear" name="">
      <bpmn:incoming>F_Inicio_M_Crear</bpmn:incoming>
      <bpmn:incoming>F_G_Valido_M_Crear</bpmn:incoming>
      <bpmn:outgoing>F_M_Crear_T_Crear</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Crear" name="Crear el proceso (BORRADOR), sus fases de consulta y flujos alternativos">
      <bpmn:incoming>F_M_Crear_T_Crear</bpmn:incoming>
      <bpmn:outgoing>F_T_Crear_T_Usuarios</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Usuarios" name="Crear usuarios y asignar responsables a cada fase">
      <bpmn:incoming>F_T_Crear_T_Usuarios</bpmn:incoming>
      <bpmn:outgoing>F_T_Usuarios_T_Carga</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Carga" name="Cargar postulantes (carga masiva o manual) y catálogo de carreras">
      <bpmn:documentation>No crea expedientes ni envía correos (§5.2).</bpmn:documentation>
      <bpmn:incoming>F_T_Usuarios_T_Carga</bpmn:incoming>
      <bpmn:outgoing>F_T_Carga_T_Activar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Activar" name="Activar el proceso">
      <bpmn:incoming>F_T_Carga_T_Activar</bpmn:incoming>
      <bpmn:outgoing>F_T_Activar_G_Valido</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Valido" name="¿Configuración válida?">
      <bpmn:documentation>Una fase inicial, una MNP, responsables en todas las fases y ningún otro proceso activo.</bpmn:documentation>
      <bpmn:incoming>F_T_Activar_G_Valido</bpmn:incoming>
      <bpmn:outgoing>F_G_Valido_M_Crear</bpmn:outgoing>
      <bpmn:outgoing>F_G_Valido_CA_Recorridos</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="CA_Recorridos" name="Recorridos de los postulantes (inicio, fases, matrícula)" calledElement="Proceso_General">
      <bpmn:incoming>F_G_Valido_CA_Recorridos</bpmn:incoming>
      <bpmn:outgoing>F_CA_Recorridos_T_Reportes</bpmn:outgoing>
      <bpmn:standardLoopCharacteristics id="Bucle_CA_Recorridos" />
    </bpmn:callActivity>
    <bpmn:userTask id="T_Reportes" name="Seguimiento con reportes y auditoría">
      <bpmn:incoming>F_CA_Recorridos_T_Reportes</bpmn:incoming>
      <bpmn:outgoing>F_T_Reportes_T_Cerrar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Cerrar" name="Cerrar el proceso">
      <bpmn:incoming>F_T_Reportes_T_Cerrar</bpmn:incoming>
      <bpmn:outgoing>F_T_Cerrar_T_Pendientes</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_Pendientes" name="No matriculados → «Proceso pendiente»; calcular totales agregados">
      <bpmn:incoming>F_T_Cerrar_T_Pendientes</bpmn:incoming>
      <bpmn:outgoing>F_T_Pendientes_T_Exportar</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_Exportar" name="Exportar los reportes necesarios (aviso 30 días antes)">
      <bpmn:incoming>F_T_Pendientes_T_Exportar</bpmn:incoming>
      <bpmn:outgoing>F_T_Exportar_E_Fecha</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="E_Fecha" name="Llega la fecha de eliminación (por defecto, 30 de noviembre)">
      <bpmn:incoming>F_T_Exportar_E_Fecha</bpmn:incoming>
      <bpmn:outgoing>F_E_Fecha_T_Purgar</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_E_Fecha" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="T_Purgar" name="Eliminar expedientes y datos personales; anonimizar la auditoría">
      <bpmn:documentation>flask purgar-datos (cron). Conserva la configuración y los totales agregados.</bpmn:documentation>
      <bpmn:incoming>F_E_Fecha_T_Purgar</bpmn:incoming>
      <bpmn:outgoing>F_T_Purgar_Fin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Fin" name="Datos eliminados; quedan los totales">
      <bpmn:incoming>F_T_Purgar_Fin</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_Inicio_M_Crear" sourceRef="Inicio" targetRef="M_Crear" />
    <bpmn:sequenceFlow id="F_M_Crear_T_Crear" sourceRef="M_Crear" targetRef="T_Crear" />
    <bpmn:sequenceFlow id="F_T_Crear_T_Usuarios" sourceRef="T_Crear" targetRef="T_Usuarios" />
    <bpmn:sequenceFlow id="F_T_Usuarios_T_Carga" sourceRef="T_Usuarios" targetRef="T_Carga" />
    <bpmn:sequenceFlow id="F_T_Carga_T_Activar" sourceRef="T_Carga" targetRef="T_Activar" />
    <bpmn:sequenceFlow id="F_T_Activar_G_Valido" sourceRef="T_Activar" targetRef="G_Valido" />
    <bpmn:sequenceFlow id="F_G_Valido_M_Crear" name="No: corregir" sourceRef="G_Valido" targetRef="M_Crear" />
    <bpmn:sequenceFlow id="F_G_Valido_CA_Recorridos" name="Sí: proceso ACTIVO" sourceRef="G_Valido" targetRef="CA_Recorridos" />
    <bpmn:sequenceFlow id="F_CA_Recorridos_T_Reportes" sourceRef="CA_Recorridos" targetRef="T_Reportes" />
    <bpmn:sequenceFlow id="F_T_Reportes_T_Cerrar" sourceRef="T_Reportes" targetRef="T_Cerrar" />
    <bpmn:sequenceFlow id="F_T_Cerrar_T_Pendientes" sourceRef="T_Cerrar" targetRef="T_Pendientes" />
    <bpmn:sequenceFlow id="F_T_Pendientes_T_Exportar" sourceRef="T_Pendientes" targetRef="T_Exportar" />
    <bpmn:sequenceFlow id="F_T_Exportar_E_Fecha" sourceRef="T_Exportar" targetRef="E_Fecha" />
    <bpmn:sequenceFlow id="F_E_Fecha_T_Purgar" sourceRef="E_Fecha" targetRef="T_Purgar" />
    <bpmn:sequenceFlow id="F_T_Purgar_Fin" sourceRef="T_Purgar" targetRef="Fin" />
    <bpmn:textAnnotation id="N_Activo"><bpmn:text>Si llega la fecha con el proceso aún ACTIVO, no se elimina nada y el Administrador recibe una alerta.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama_Ciclo">
    <bpmndi:BPMNPlane id="Plano_Ciclo" bpmnElement="Colaboracion_Ciclo">
      <bpmndi:BPMNShape id="Pool_Ciclo_di" bpmnElement="Pool_Ciclo" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="2620" height="560" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Admin_di" bpmnElement="L_Admin" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="2590" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Ges_di" bpmnElement="L_Ges" isHorizontal="true">
        <dc:Bounds x="150" y="220" width="2590" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Staff_di" bpmnElement="L_Staff" isHorizontal="true">
        <dc:Bounds x="150" y="360" width="2590" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Sis_di" bpmnElement="L_Sis" isHorizontal="true">
        <dc:Bounds x="150" y="500" width="2590" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Inicio_di" bpmnElement="Inicio">
        <dc:Bounds x="207" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="170" y="172" width="110" height="36" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="M_Crear_di" bpmnElement="M_Crear" isMarkerVisible="true">
        <dc:Bounds x="310" y="125" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="280" y="179" width="110" height="36" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Crear_di" bpmnElement="T_Crear">
        <dc:Bounds x="390" y="110" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Usuarios_di" bpmnElement="T_Usuarios">
        <dc:Bounds x="565" y="110" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Carga_di" bpmnElement="T_Carga">
        <dc:Bounds x="740" y="250" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Activar_di" bpmnElement="T_Activar">
        <dc:Bounds x="915" y="110" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Valido_di" bpmnElement="G_Valido" isMarkerVisible="true">
        <dc:Bounds x="1130" y="125" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1100" y="179" width="110" height="36" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CA_Recorridos_di" bpmnElement="CA_Recorridos">
        <dc:Bounds x="1265" y="390" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Reportes_di" bpmnElement="T_Reportes">
        <dc:Bounds x="1440" y="250" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Cerrar_di" bpmnElement="T_Cerrar">
        <dc:Bounds x="1615" y="110" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Pendientes_di" bpmnElement="T_Pendientes">
        <dc:Bounds x="1790" y="530" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Exportar_di" bpmnElement="T_Exportar">
        <dc:Bounds x="1965" y="250" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_Fecha_di" bpmnElement="E_Fecha">
        <dc:Bounds x="2187" y="552" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="2150" y="592" width="110" height="36" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Purgar_di" bpmnElement="T_Purgar">
        <dc:Bounds x="2315" y="530" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Fin_di" bpmnElement="Fin">
        <dc:Bounds x="2537" y="552" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="2500" y="592" width="110" height="36" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F_Inicio_M_Crear_di" bpmnElement="F_Inicio_M_Crear">
        <di:waypoint x="243" y="150" />
        <di:waypoint x="310" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_M_Crear_T_Crear_di" bpmnElement="F_M_Crear_T_Crear">
        <di:waypoint x="360" y="150" />
        <di:waypoint x="390" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_T_Crear_T_Usuarios_di" bpmnElement="F_T_Crear_T_Usuarios">
        <di:waypoint x="520" y="150" />
        <di:waypoint x="565" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_T_Usuarios_T_Carga_di" bpmnElement="F_T_Usuarios_T_Carga">
        <di:waypoint x="695" y="150" />
        <di:waypoint x="718" y="150" />
        <di:waypoint x="718" y="290" />
        <di:waypoint x="740" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_T_Carga_T_Activar_di" bpmnElement="F_T_Carga_T_Activar">
        <di:waypoint x="870" y="290" />
        <di:waypoint x="892" y="290" />
        <di:waypoint x="892" y="150" />
        <di:waypoint x="915" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_T_Activar_G_Valido_di" bpmnElement="F_T_Activar_G_Valido">
        <di:waypoint x="1045" y="150" />
        <di:waypoint x="1130" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_G_Valido_M_Crear_di" bpmnElement="F_G_Valido_M_Crear">
        <di:waypoint x="1155" y="125" />
        <di:waypoint x="1155" y="94" />
        <di:waypoint x="335" y="94" />
        <di:waypoint x="335" y="125" />
        <bpmndi:BPMNLabel><dc:Bounds x="704" y="98" width="81" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_G_Valido_CA_Recorridos_di" bpmnElement="F_G_Valido_CA_Recorridos">
        <di:waypoint x="1155" y="175" />
        <di:waypoint x="1155" y="430" />
        <di:waypoint x="1265" y="430" />
        <bpmndi:BPMNLabel><dc:Bounds x="1161" y="296" width="122" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_CA_Recorridos_T_Reportes_di" bpmnElement="F_CA_Recorridos_T_Reportes">
        <di:waypoint x="1395" y="430" />
        <di:waypoint x="1418" y="430" />
        <di:waypoint x="1418" y="290" />
        <di:waypoint x="1440" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_T_Reportes_T_Cerrar_di" bpmnElement="F_T_Reportes_T_Cerrar">
        <di:waypoint x="1570" y="290" />
        <di:waypoint x="1592" y="290" />
        <di:waypoint x="1592" y="150" />
        <di:waypoint x="1615" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_T_Cerrar_T_Pendientes_di" bpmnElement="F_T_Cerrar_T_Pendientes">
        <di:waypoint x="1745" y="150" />
        <di:waypoint x="1768" y="150" />
        <di:waypoint x="1768" y="570" />
        <di:waypoint x="1790" y="570" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_T_Pendientes_T_Exportar_di" bpmnElement="F_T_Pendientes_T_Exportar">
        <di:waypoint x="1920" y="570" />
        <di:waypoint x="1942" y="570" />
        <di:waypoint x="1942" y="290" />
        <di:waypoint x="1965" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_T_Exportar_E_Fecha_di" bpmnElement="F_T_Exportar_E_Fecha">
        <di:waypoint x="2095" y="290" />
        <di:waypoint x="2141" y="290" />
        <di:waypoint x="2141" y="570" />
        <di:waypoint x="2187" y="570" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_E_Fecha_T_Purgar_di" bpmnElement="F_E_Fecha_T_Purgar">
        <di:waypoint x="2223" y="570" />
        <di:waypoint x="2315" y="570" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_T_Purgar_Fin_di" bpmnElement="F_T_Purgar_Fin">
        <di:waypoint x="2445" y="570" />
        <di:waypoint x="2537" y="570" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="N_Activo_di" bpmnElement="N_Activo">
        <dc:Bounds x="2065" y="125" width="280" height="50" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
