<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definiciones_InicioStaff" targetNamespace="http://unach.cl/workflow-matricula" exporter="Sistema WorkFlow Matrícula" exporterVersion="1.0">
  <bpmn:collaboration id="Colaboracion_InicioStaff">
    <bpmn:participant id="Pool_InicioStaff" name="Inicio por staff" processRef="Proceso_InicioStaff" />
  </bpmn:collaboration>
  <bpmn:process id="Proceso_InicioStaff" name="Inicio de proceso por staff" isExecutable="false">
    <bpmn:documentation>RF-09 y RF-11. Lo hacen los responsables de «Iniciado», el Gestor o el Administrador. No requiere el permiso de carga manual.</bpmn:documentation>
    <bpmn:laneSet id="Carriles_InicioStaff">
      <bpmn:lane id="L_Ini" name="Responsable de Iniciado">
        <bpmn:flowNodeRef>I_Staff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Rut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Exp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_Exp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Nuevo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Dudas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Directa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Consultas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Flujo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Ruta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Indicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_Staff</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Sis" name="Sistema">
        <bpmn:flowNodeRef>T_Crear</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="I_Staff" name="Postulante en el módulo de inicio">
      <bpmn:outgoing>F_I_Staff_T_Rut</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_Rut" name="Ingresar el RUT">
      <bpmn:incoming>F_I_Staff_T_Rut</bpmn:incoming>
      <bpmn:outgoing>F_T_Rut_G_Exp</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Exp" name="¿Ya tiene expediente?">
      <bpmn:incoming>F_T_Rut_G_Exp</bpmn:incoming>
      <bpmn:outgoing>F_G_Exp_F_Exp</bpmn:outgoing>
      <bpmn:outgoing>F_G_Exp_G_Reg</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="F_Exp" name="Muestra su expediente (puede reenviar el enlace)">
      <bpmn:incoming>F_G_Exp_F_Exp</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G_Reg" name="¿RUT registrado?">
      <bpmn:incoming>F_G_Exp_G_Reg</bpmn:incoming>
      <bpmn:outgoing>F_G_Reg_T_Revisar</bpmn:outgoing>
      <bpmn:outgoing>F_G_Reg_T_Nuevo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Revisar" name="Revisar y corregir sus datos (excepto el RUT)">
      <bpmn:incoming>F_G_Reg_T_Revisar</bpmn:incoming>
      <bpmn:outgoing>F_T_Revisar_M_Datos</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Nuevo" name="Completar los datos del postulante">
      <bpmn:incoming>F_G_Reg_T_Nuevo</bpmn:incoming>
      <bpmn:outgoing>F_T_Nuevo_M_Datos</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="M_Datos" name="">
      <bpmn:incoming>F_T_Revisar_M_Datos</bpmn:incoming>
      <bpmn:incoming>F_T_Nuevo_M_Datos</bpmn:incoming>
      <bpmn:outgoing>F_M_Datos_G_Dudas</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_Dudas" name="¿El postulante tiene dudas?">
      <bpmn:incoming>F_M_Datos_G_Dudas</bpmn:incoming>
      <bpmn:outgoing>F_G_Dudas_T_Directa</bpmn:outgoing>
      <bpmn:outgoing>F_G_Dudas_T_Consultas</bpmn:outgoing>
      <bpmn:outgoing>F_G_Dudas_T_Flujo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_Directa" name="Ruta directa: Iniciado → MNP">
      <bpmn:incoming>F_G_Dudas_T_Directa</bpmn:incoming>
      <bpmn:outgoing>F_T_Directa_M_Ruta</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="T_Consultas" name="Numerar las fases de consulta en orden (MNP al final)">
      <bpmn:incoming>F_G_Dudas_T_Consultas</bpmn:incoming>
      <bpmn:outgoing>F_T_Consultas_M_Ruta</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Flujo" name="Elegir flujo alternativo y fase de entrada">
      <bpmn:incoming>F_G_Dudas_T_Flujo</bpmn:incoming>
      <bpmn:outgoing>F_T_Flujo_M_Ruta</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="M_Ruta" name="">
      <bpmn:incoming>F_T_Directa_M_Ruta</bpmn:incoming>
      <bpmn:incoming>F_T_Consultas_M_Ruta</bpmn:incoming>
      <bpmn:incoming>F_T_Flujo_M_Ruta</bpmn:incoming>
      <bpmn:outgoing>F_M_Ruta_T_Crear</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Crear" name="Crear expediente, asignar número, enviar correo y activar la primera fase">
      <bpmn:incoming>F_M_Ruta_T_Crear</bpmn:incoming>
      <bpmn:outgoing>F_T_Crear_T_Indicar</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_Indicar" name="Indicarle su número y a qué fase dirigirse">
      <bpmn:incoming>F_T_Crear_T_Indicar</bpmn:incoming>
      <bpmn:outgoing>F_T_Indicar_F_Staff</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="F_Staff" name="Postulante derivado a su primera fase">
      <bpmn:incoming>F_T_Indicar_F_Staff</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_I_Staff_T_Rut" sourceRef="I_Staff" targetRef="T_Rut" />
    <bpmn:sequenceFlow id="F_T_Rut_G_Exp" sourceRef="T_Rut" targetRef="G_Exp" />
    <bpmn:sequenceFlow id="F_G_Exp_F_Exp" name="Sí" sourceRef="G_Exp" targetRef="F_Exp" />
    <bpmn:sequenceFlow id="F_G_Exp_G_Reg" name="No" sourceRef="G_Exp" targetRef="G_Reg" />
    <bpmn:sequenceFlow id="F_G_Reg_T_Revisar" name="Sí" sourceRef="G_Reg" targetRef="T_Revisar" />
    <bpmn:sequenceFlow id="F_G_Reg_T_Nuevo" name="No" sourceRef="G_Reg" targetRef="T_Nuevo" />
    <bpmn:sequenceFlow id="F_T_Revisar_M_Datos" sourceRef="T_Revisar" targetRef="M_Datos" />
    <bpmn:sequenceFlow id="F_T_Nuevo_M_Datos" sourceRef="T_Nuevo" targetRef="M_Datos" />
    <bpmn:sequenceFlow id="F_M_Datos_G_Dudas" sourceRef="M_Datos" targetRef="G_Dudas" />
    <bpmn:sequenceFlow id="F_G_Dudas_T_Directa" name="No" sourceRef="G_Dudas" targetRef="T_Directa" />
    <bpmn:sequenceFlow id="F_G_Dudas_T_Consultas" name="Sí" sourceRef="G_Dudas" targetRef="T_Consultas" />
    <bpmn:sequenceFlow id="F_G_Dudas_T_Flujo" name="No termina en MNP" sourceRef="G_Dudas" targetRef="T_Flujo" />
    <bpmn:sequenceFlow id="F_T_Directa_M_Ruta" sourceRef="T_Directa" targetRef="M_Ruta" />
    <bpmn:sequenceFlow id="F_T_Consultas_M_Ruta" sourceRef="T_Consultas" targetRef="M_Ruta" />
    <bpmn:sequenceFlow id="F_T_Flujo_M_Ruta" sourceRef="T_Flujo" targetRef="M_Ruta" />
    <bpmn:sequenceFlow id="F_M_Ruta_T_Crear" sourceRef="M_Ruta" targetRef="T_Crear" />
    <bpmn:sequenceFlow id="F_T_Crear_T_Indicar" sourceRef="T_Crear" targetRef="T_Indicar" />
    <bpmn:sequenceFlow id="F_T_Indicar_F_Staff" sourceRef="T_Indicar" targetRef="F_Staff" />
    <bpmn:textAnnotation id="N_Dudas"><bpmn:text>No se puede confirmar sin responder «¿Tiene dudas?».</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama_InicioStaff">
    <bpmndi:BPMNPlane id="Plano_InicioStaff" bpmnElement="Colaboracion_InicioStaff">
      <bpmndi:BPMNShape id="Pool_InicioStaff_di" bpmnElement="Pool_InicioStaff" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="2270" height="520" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Ini_di" bpmnElement="L_Ini" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="2240" height="380" />
