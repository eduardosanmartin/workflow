        <di:waypoint x="1570" y="270" />
        <di:waypoint x="1655" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_T_Flujo_M_Ruta_di" bpmnElement="F_T_Flujo_M_Ruta">
        <di:waypoint x="1570" y="390" />
        <di:waypoint x="1680" y="390" />
        <di:waypoint x="1680" y="295" />
      </bpmndi:BPMNEdge>
