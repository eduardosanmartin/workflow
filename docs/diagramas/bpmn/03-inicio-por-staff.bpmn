      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F_Exp_di" bpmnElement="F_Exp">
        <dc:Bounds x="612" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="575" y="92" width="110" height="36" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Reg_di" bpmnElement="G_Reg" isMarkerVisible="true">
        <dc:Bounds x="780" y="245" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="750" y="299" width="110" height="36" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Revisar_di" bpmnElement="T_Revisar">
        <dc:Bounds x="915" y="110" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Nuevo_di" bpmnElement="T_Nuevo">
        <dc:Bounds x="915" y="230" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="M_Datos_di" bpmnElement="M_Datos" isMarkerVisible="true">
        <dc:Bounds x="1130" y="245" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1100" y="299" width="110" height="36" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Dudas_di" bpmnElement="G_Dudas" isMarkerVisible="true">
        <dc:Bounds x="1305" y="245" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1275" y="299" width="110" height="36" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Directa_di" bpmnElement="T_Directa">
        <dc:Bounds x="1440" y="110" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Consultas_di" bpmnElement="T_Consultas">
        <dc:Bounds x="1440" y="230" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Flujo_di" bpmnElement="T_Flujo">
        <dc:Bounds x="1440" y="350" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="M_Ruta_di" bpmnElement="M_Ruta" isMarkerVisible="true">
        <dc:Bounds x="1655" y="245" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1625" y="299" width="110" height="36" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Crear_di" bpmnElement="T_Crear">
        <dc:Bounds x="1790" y="490" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Indicar_di" bpmnElement="T_Indicar">
        <dc:Bounds x="1965" y="230" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F_Staff_di" bpmnElement="F_Staff">
        <dc:Bounds x="2187" y="252" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="2150" y="292" width="110" height="36" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F_I_Staff_T_Rut_di" bpmnElement="F_I_Staff_T_Rut">
        <di:waypoint x="298" y="270" />
        <di:waypoint x="390" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_T_Rut_G_Exp_di" bpmnElement="F_T_Rut_G_Exp">
        <di:waypoint x="520" y="270" />
        <di:waypoint x="605" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_G_Exp_F_Exp_di" bpmnElement="F_G_Exp_F_Exp">
        <di:waypoint x="630" y="245" />
        <di:waypoint x="630" y="168" />
        <bpmndi:BPMNLabel><dc:Bounds x="636" y="200" width="60" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_G_Exp_G_Reg_di" bpmnElement="F_G_Exp_G_Reg">
        <di:waypoint x="655" y="270" />
        <di:waypoint x="780" y="270" />
        <bpmndi:BPMNLabel><dc:Bounds x="688" y="252" width="60" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_G_Reg_T_Revisar_di" bpmnElement="F_G_Reg_T_Revisar">
        <di:waypoint x="805" y="245" />
        <di:waypoint x="805" y="150" />
        <di:waypoint x="915" y="150" />
        <bpmndi:BPMNLabel><dc:Bounds x="830" y="132" width="60" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_G_Reg_T_Nuevo_di" bpmnElement="F_G_Reg_T_Nuevo">
        <di:waypoint x="830" y="270" />
        <di:waypoint x="915" y="270" />
        <bpmndi:BPMNLabel><dc:Bounds x="842" y="252" width="60" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
