        <di:waypoint x="1045" y="150" />
        <di:waypoint x="1155" y="150" />
        <di:waypoint x="1155" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_T_Nuevo_M_Datos_di" bpmnElement="F_T_Nuevo_M_Datos">
        <di:waypoint x="1045" y="270" />
        <di:waypoint x="1130" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_M_Datos_G_Dudas_di" bpmnElement="F_M_Datos_G_Dudas">
        <di:waypoint x="1180" y="270" />
        <di:waypoint x="1305" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_G_Dudas_T_Directa_di" bpmnElement="F_G_Dudas_T_Directa">
        <di:waypoint x="1330" y="245" />
        <di:waypoint x="1330" y="150" />
        <di:waypoint x="1440" y="150" />
        <bpmndi:BPMNLabel><dc:Bounds x="1355" y="132" width="60" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_G_Dudas_T_Consultas_di" bpmnElement="F_G_Dudas_T_Consultas">
        <di:waypoint x="1355" y="270" />
        <di:waypoint x="1440" y="270" />
        <bpmndi:BPMNLabel><dc:Bounds x="1368" y="252" width="60" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_G_Dudas_T_Flujo_di" bpmnElement="F_G_Dudas_T_Flujo">
