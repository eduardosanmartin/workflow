        <dc:Bounds x="1790" y="110" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Crear_di" bpmnElement="T_Crear">
        <dc:Bounds x="1965" y="250" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Seguimiento_di" bpmnElement="T_Seguimiento">
        <dc:Bounds x="2140" y="110" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="F_Qr_di" bpmnElement="F_Qr">
        <dc:Bounds x="2362" y="132" width="36" height="36" />
