<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definiciones_InicioQr" targetNamespace="http://unach.cl/workflow-matricula" exporter="Sistema WorkFlow Matrícula" exporterVersion="1.0">
  <bpmn:collaboration id="Colaboracion_InicioQr">
    <bpmn:participant id="Pool_InicioQr" name="Inicio por QR (autoinicio)" processRef="Proceso_InicioQr" />
  </bpmn:collaboration>
  <bpmn:process id="Proceso_InicioQr" name="Inicio de proceso por QR" isExecutable="false">
    <bpmn:documentation>RF-10 y RF-11. Formulario público optimizado para celular. Solo con un proceso ACTIVO; un RUT tiene un solo expediente por proceso.</bpmn:documentation>
    <bpmn:laneSet id="Carriles_InicioQr">
      <bpmn:lane id="L_Post" name="Postulante (formulario QR, público)">
        <bpmn:flowNodeRef>I_Qr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Rut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Rut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Completar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Seguimiento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_Qr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Sis" name="Sistema">
        <bpmn:flowNodeRef>G_Activo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_Cerrado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_RutOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_TieneExp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Reenviar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>F_Reenviado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Registrado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Enmascarar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Completo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_Datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Crear</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="I_Qr" name="Escanea el QR «Inicia aquí»">
      <bpmn:outgoing>F_I_Qr_G_Activo</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="G_Activo" name="¿Hay un proceso activo?">
      <bpmn:incoming>F_I_Qr_G_Activo</bpmn:incoming>
      <bpmn:outgoing>F_G_Activo_F_Cerrado</bpmn:outgoing>
      <bpmn:outgoing>F_G_Activo_M_Rut</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="F_Cerrado" name="«El proceso de matrícula no está abierto»">
      <bpmn:incoming>F_G_Activo_F_Cerrado</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="M_Rut" name="">
      <bpmn:incoming>F_G_Activo_M_Rut</bpmn:incoming>
      <bpmn:incoming>F_G_RutOk_M_Rut</bpmn:incoming>
      <bpmn:outgoing>F_M_Rut_T_Rut</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Rut" name="Ingresa su RUT y resuelve el CAPTCHA">
      <bpmn:incoming>F_M_Rut_T_Rut</bpmn:incoming>
      <bpmn:outgoing>F_T_Rut_T_Validar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_Validar" name="Validar CAPTCHA y RUT (dígito verificador)">
      <bpmn:incoming>F_T_Rut_T_Validar</bpmn:incoming>
      <bpmn:outgoing>F_T_Validar_G_RutOk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_RutOk" name="¿Válido?">
      <bpmn:incoming>F_T_Validar_G_RutOk</bpmn:incoming>
      <bpmn:outgoing>F_G_RutOk_M_Rut</bpmn:outgoing>
      <bpmn:outgoing>F_G_RutOk_G_TieneExp</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_TieneExp" name="¿Ya tiene expediente en el proceso?">
      <bpmn:incoming>F_G_RutOk_G_TieneExp</bpmn:incoming>
      <bpmn:outgoing>F_G_TieneExp_T_Reenviar</bpmn:outgoing>
      <bpmn:outgoing>F_G_TieneExp_G_Registrado</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T_Reenviar" name="Reenviar el enlace a su correo registrado (máx. 3 por hora)">
      <bpmn:documentation>No muestra el enlace en pantalla: «Te enviamos tu enlace a j***@gmail.com».</bpmn:documentation>
      <bpmn:incoming>F_G_TieneExp_T_Reenviar</bpmn:incoming>
      <bpmn:outgoing>F_T_Reenviar_F_Reenviado</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="F_Reenviado" name="Enlace reenviado">
      <bpmn:incoming>F_T_Reenviar_F_Reenviado</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G_Registrado" name="¿RUT registrado?">
      <bpmn:incoming>F_G_TieneExp_G_Registrado</bpmn:incoming>
      <bpmn:outgoing>F_G_Registrado_T_Enmascarar</bpmn:outgoing>
      <bpmn:outgoing>F_G_Registrado_T_Completo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Enmascarar" name="Mostrar sus datos enmascarados y pedir solo los pendientes">
      <bpmn:incoming>F_G_Registrado_T_Enmascarar</bpmn:incoming>
      <bpmn:outgoing>F_T_Enmascarar_M_Datos</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_Completo" name="Mostrar el formulario completo">
      <bpmn:incoming>F_G_Registrado_T_Completo</bpmn:incoming>
      <bpmn:outgoing>F_T_Completo_M_Datos</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="M_Datos" name="">
      <bpmn:incoming>F_T_Enmascarar_M_Datos</bpmn:incoming>
      <bpmn:incoming>F_T_Completo_M_Datos</bpmn:incoming>
      <bpmn:outgoing>F_M_Datos_T_Completar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Completar" name="Completa los datos pendientes y marca sus temas de duda">
      <bpmn:incoming>F_M_Datos_T_Completar</bpmn:incoming>
      <bpmn:outgoing>F_T_Completar_T_Crear</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_Crear" name="Crear expediente EN_ESPERA en «Iniciado», asignar número y enviar correo">
      <bpmn:incoming>F_T_Completar_T_Crear</bpmn:incoming>
      <bpmn:outgoing>F_T_Crear_T_Seguimiento</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="T_Seguimiento" name="Ve su número y su recorrido en el celular">
      <bpmn:incoming>F_T_Crear_T_Seguimiento</bpmn:incoming>
      <bpmn:outgoing>F_T_Seguimiento_F_Qr</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="F_Qr" name="Espera en «Iniciado» con su ruta propuesta">
      <bpmn:incoming>F_T_Seguimiento_F_Qr</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_I_Qr_G_Activo" sourceRef="I_Qr" targetRef="G_Activo" />
    <bpmn:sequenceFlow id="F_G_Activo_F_Cerrado" name="No" sourceRef="G_Activo" targetRef="F_Cerrado" />
    <bpmn:sequenceFlow id="F_G_Activo_M_Rut" name="Sí" sourceRef="G_Activo" targetRef="M_Rut" />
    <bpmn:sequenceFlow id="F_M_Rut_T_Rut" sourceRef="M_Rut" targetRef="T_Rut" />
    <bpmn:sequenceFlow id="F_T_Rut_T_Validar" sourceRef="T_Rut" targetRef="T_Validar" />
    <bpmn:sequenceFlow id="F_T_Validar_G_RutOk" sourceRef="T_Validar" targetRef="G_RutOk" />
    <bpmn:sequenceFlow id="F_G_RutOk_M_Rut" name="No: corregir" sourceRef="G_RutOk" targetRef="M_Rut" />
    <bpmn:sequenceFlow id="F_G_RutOk_G_TieneExp" name="Sí" sourceRef="G_RutOk" targetRef="G_TieneExp" />
    <bpmn:sequenceFlow id="F_G_TieneExp_T_Reenviar" name="Sí" sourceRef="G_TieneExp" targetRef="T_Reenviar" />
    <bpmn:sequenceFlow id="F_G_TieneExp_G_Registrado" name="No" sourceRef="G_TieneExp" targetRef="G_Registrado" />
    <bpmn:sequenceFlow id="F_T_Reenviar_F_Reenviado" sourceRef="T_Reenviar" targetRef="F_Reenviado" />
    <bpmn:sequenceFlow id="F_G_Registrado_T_Enmascarar" name="Sí" sourceRef="G_Registrado" targetRef="T_Enmascarar" />
    <bpmn:sequenceFlow id="F_G_Registrado_T_Completo" name="No" sourceRef="G_Registrado" targetRef="T_Completo" />
    <bpmn:sequenceFlow id="F_T_Enmascarar_M_Datos" sourceRef="T_Enmascarar" targetRef="M_Datos" />
    <bpmn:sequenceFlow id="F_T_Completo_M_Datos" sourceRef="T_Completo" targetRef="M_Datos" />
    <bpmn:sequenceFlow id="F_M_Datos_T_Completar" sourceRef="M_Datos" targetRef="T_Completar" />
    <bpmn:sequenceFlow id="F_T_Completar_T_Crear" sourceRef="T_Completar" targetRef="T_Crear" />
    <bpmn:sequenceFlow id="F_T_Crear_T_Seguimiento" sourceRef="T_Crear" targetRef="T_Seguimiento" />
    <bpmn:sequenceFlow id="F_T_Seguimiento_F_Qr" sourceRef="T_Seguimiento" targetRef="F_Qr" />
    <bpmn:textAnnotation id="N_Privacidad"><bpmn:text>Con «enmascarar datos» activo (por defecto), la página nunca contiene los datos completos: Ju*** Pé***, j***@gmail.com.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="N_Concurrencia"><bpmn:text>El inicio bloquea el proceso activo: dos inicios simultáneos del mismo RUT crean un solo expediente.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama_InicioQr">
    <bpmndi:BPMNPlane id="Plano_InicioQr" bpmnElement="Colaboracion_InicioQr">
