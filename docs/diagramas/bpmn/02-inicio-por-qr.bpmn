        <di:waypoint x="1155" y="315" />
        <di:waypoint x="1155" y="370" />
        <bpmndi:BPMNLabel><dc:Bounds x="1161" y="336" width="60" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_G_TieneExp_G_Registrado_di" bpmnElement="F_G_TieneExp_G_Registrado">
        <di:waypoint x="1180" y="290" />
        <di:waypoint x="1305" y="290" />
        <bpmndi:BPMNLabel><dc:Bounds x="1212" y="272" width="60" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_T_Reenviar_F_Reenviado_di" bpmnElement="F_T_Reenviar_F_Reenviado">
        <di:waypoint x="1220" y="410" />
        <di:waypoint x="1312" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_G_Registrado_T_Enmascarar_di" bpmnElement="F_G_Registrado_T_Enmascarar">
        <di:waypoint x="1355" y="290" />
        <di:waypoint x="1440" y="290" />
        <bpmndi:BPMNLabel><dc:Bounds x="1368" y="272" width="60" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_G_Registrado_T_Completo_di" bpmnElement="F_G_Registrado_T_Completo">
        <di:waypoint x="1355" y="290" />
        <di:waypoint x="1385" y="290" />
        <di:waypoint x="1385" y="410" />
        <di:waypoint x="1440" y="410" />
        <bpmndi:BPMNLabel><dc:Bounds x="1391" y="343" width="60" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_T_Enmascarar_M_Datos_di" bpmnElement="F_T_Enmascarar_M_Datos">
        <di:waypoint x="1570" y="290" />
        <di:waypoint x="1655" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_T_Completo_M_Datos_di" bpmnElement="F_T_Completo_M_Datos">
        <di:waypoint x="1570" y="410" />
        <di:waypoint x="1680" y="410" />
        <di:waypoint x="1680" y="315" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_M_Datos_T_Completar_di" bpmnElement="F_M_Datos_T_Completar">
        <di:waypoint x="1680" y="265" />
        <di:waypoint x="1680" y="150" />
        <di:waypoint x="1790" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_T_Completar_T_Crear_di" bpmnElement="F_T_Completar_T_Crear">
        <di:waypoint x="1920" y="150" />
        <di:waypoint x="1942" y="150" />
